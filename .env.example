# ADK Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model
MODEL=gemini-2.5-flash

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-maps-api-key

# AlloyDB Connection
ALLOYDB_INSTANCE_URI=projects/PROJECT/locations/REGION/clusters/CLUSTER/instances/INSTANCE
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=your-password
ALLOYDB_DB=crisisconnect

# Service Account (for Cloud Run deployment)
SA_NAME=crisisconnect-sa
